diff --git a/fs/susfs.c b/fs/susfs.c
--- a/fs/susfs.c
+++ b/fs/susfs.c
@@ -831,6 +831,84 @@ struct filename* susfs_get_redirected_path(unsigned long ino) {
 struct filename* susfs_get_redirected_path(unsigned long ino) {
 	struct st_susfs_open_redirect_hlist *entry;

 	hash_for_each_possible(OPEN_REDIRECT_HLIST, entry, node, ino) {
 		if (entry->target_ino == ino) {
 			SUSFS_LOGI("Redirect for ino: %lu\n", ino);
 			return getname_kernel(entry->redirected_pathname);
 		}
 	}
 	return ERR_PTR(-ENOENT);
 }
 #endif // #ifdef CONFIG_KSU_SUSFS_OPEN_REDIRECT
+
+/* clock_offset */
+#ifdef CONFIG_KSU_SUSFS_CLOCK_OFFSET
+static DEFINE_HASHTABLE(CLOCK_OFFSET_HLIST, 4);
+static bool susfs_clock_offset_active = false;
+
+int susfs_add_clock_offset(struct st_susfs_clock_offset* __user user_info) {
+	struct st_susfs_clock_offset info;
+	struct st_susfs_clock_offset_hlist *new_entry, *tmp_entry;
+	struct hlist_node *tmp_node;
+	int bkt;
+
+	if (copy_from_user(&info, user_info, sizeof(info))) {
+		SUSFS_LOGE("failed copying from userspace\n");
+		return 1;
+	}
+
+	/* replace an existing entry for this uid */
+	spin_lock(&susfs_spin_lock);
+	hash_for_each_safe(CLOCK_OFFSET_HLIST, bkt, tmp_node, tmp_entry, node) {
+		if (tmp_entry->target_uid == info.target_uid) {
+			hash_del(&tmp_entry->node);
+			kfree(tmp_entry);
+			break;
+		}
+	}
+	spin_unlock(&susfs_spin_lock);
+
+	new_entry = kmalloc(sizeof(struct st_susfs_clock_offset_hlist), GFP_KERNEL);
+	if (!new_entry) {
+		SUSFS_LOGE("no enough memory\n");
+		return 1;
+	}
+	new_entry->target_uid = info.target_uid;
+	new_entry->delta_mono_ns = info.delta_mono_ns;
+	new_entry->delta_boot_ns = info.delta_boot_ns;
+
+	spin_lock(&susfs_spin_lock);
+	hash_add(CLOCK_OFFSET_HLIST, &new_entry->node, (unsigned int)info.target_uid);
+	susfs_clock_offset_active = true;
+	spin_unlock(&susfs_spin_lock);
+	SUSFS_LOGI("clock_offset added: uid=%d delta_mono=%lld delta_boot=%lld\n",
+			info.target_uid, info.delta_mono_ns, info.delta_boot_ns);
+	return 0;
+}
+
+/*
+ * Called from the clock_gettime(2) SYSCALL path (raw svc only; the vDSO fast
+ * path never reaches here, so Choreographer/vsync are untouched). Adds the
+ * registered per-uid delta to CLOCK_MONOTONIC* and CLOCK_BOOTTIME results so a
+ * freshly-booted device presents a realistic uptime to raw-syscall clock readers.
+ */
+void susfs_apply_clock_offset(const clockid_t which_clock, struct timespec64 *tp) {
+	struct st_susfs_clock_offset_hlist *entry;
+	uid_t uid;
+	long long d = 0;
+
+	if (!susfs_clock_offset_active)
+		return;
+	uid = current_uid().val;
+
+	spin_lock(&susfs_spin_lock);
+	hash_for_each_possible(CLOCK_OFFSET_HLIST, entry, node, uid) {
+		if (entry->target_uid == uid) {
+			if (which_clock == CLOCK_BOOTTIME || which_clock == CLOCK_BOOTTIME_ALARM)
+				d = entry->delta_boot_ns;
+			else if (which_clock == CLOCK_MONOTONIC ||
+			         which_clock == CLOCK_MONOTONIC_RAW ||
+			         which_clock == CLOCK_MONOTONIC_COARSE)
+				d = entry->delta_mono_ns;
+			break;
+		}
+	}
+	spin_unlock(&susfs_spin_lock);
+
+	if (d > 0)
+		timespec64_add_ns(tp, (u64)d);
+}
+#endif // #ifdef CONFIG_KSU_SUSFS_CLOCK_OFFSET

diff --git a/kernel/time/posix-timers.c b/kernel/time/posix-timers.c
--- a/kernel/time/posix-timers.c
+++ b/kernel/time/posix-timers.c
@@ -1065,6 +1065,10 @@
 }

+#ifdef CONFIG_KSU_SUSFS_CLOCK_OFFSET
+extern void susfs_apply_clock_offset(const clockid_t which_clock, struct timespec64 *tp);
+#endif
+
 SYSCALL_DEFINE2(clock_gettime, const clockid_t, which_clock,
 		struct timespec __user *,tp)
 {
@@ -1076,6 +1080,10 @@ SYSCALL_DEFINE2(clock_gettime, const clockid_t, which_clock,
 		return -EINVAL;

 	error = kc->clock_get(which_clock, &kernel_tp);

+#ifdef CONFIG_KSU_SUSFS_CLOCK_OFFSET
+	if (!error)
+		susfs_apply_clock_offset(which_clock, &kernel_tp);
+#endif
 	if (!error && put_timespec64(&kernel_tp, tp))
 		error = -EFAULT;

@@ -1152,6 +1160,10 @@ COMPAT_SYSCALL_DEFINE2(clock_gettime, clockid_t, which_clock,
 		return -EINVAL;

 	err = kc->clock_get(which_clock, &ts);

+#ifdef CONFIG_KSU_SUSFS_CLOCK_OFFSET
+	if (!err)
+		susfs_apply_clock_offset(which_clock, &ts);
+#endif
 	if (!err && compat_put_timespec64(&ts, tp))
 		err = -EFAULT;

