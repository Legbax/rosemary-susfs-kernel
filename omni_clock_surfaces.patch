From: OmniShield <legba@omnishield>
Subject: [PATCH] susfs clock_offset: extend per-uid uptime spoof to the 3 non-syscall
 surfaces the Snap login member cross-reads (/proc/uptime, sysinfo, /proc/stat btime)

The existing omni_clock_offset.patch only offsets the clock_gettime(2) SYSCALL path.
Snap's login/signup member ALSO cross-reads /proc/uptime + sysinfo() + /proc/stat btime;
with only the syscall covered, those 3 leak the real fresh-boot uptime -> the member is
incoherent -> rc16. This adds the SAME per-uid boot delta to all 3 (btime gets -delta,
since a later boot wall-clock == a larger uptime). Gated by CONFIG_KSU_SUSFS_CLOCK_OFFSET
and by current_uid() (only the registered uid sees the spoof; root/system read real).
4.14 accessors (pre-timens): get_monotonic_boottime (BOOTTIME) / getboottime64.
Apply AFTER omni_clock_offset.patch.
---
 fs/proc/stat.c          |  9 +++++++++
 fs/proc/uptime.c        |  9 +++++++++
 fs/susfs.c              | 19 +++++++++++++++++++
 include/linux/susfs.h   |  1 +
 kernel/sys.c            |  9 +++++++++
 5 files changed, 47 insertions(+)

diff --git a/include/linux/susfs.h b/include/linux/susfs.h
--- a/include/linux/susfs.h
+++ b/include/linux/susfs.h
@@ -189,6 +189,7 @@ struct filename* susfs_get_redirected_path(unsigned long ino);
 #ifdef CONFIG_KSU_SUSFS_CLOCK_OFFSET
 int susfs_add_clock_offset(struct st_susfs_clock_offset* __user user_info);
 void susfs_apply_clock_offset(const clockid_t which_clock, struct timespec64 *tp);
+long long susfs_get_clock_boot_off_current(void);
 #endif
 /* sus_su */
 #ifdef CONFIG_KSU_SUSFS_SUS_SU

diff --git a/fs/susfs.c b/fs/susfs.c
--- a/fs/susfs.c
+++ b/fs/susfs.c
@@ -910,6 +910,25 @@ void susfs_apply_clock_offset(const clockid_t which_clock, struct timespec64 *tp
 	if (d > 0)
 		timespec64_add_ns(tp, (u64)d);
 }
+
+/*
+ * Returns the registered BOOTTIME delta (ns) for the CURRENT uid, else 0.
+ * Used by the non-syscall uptime surfaces (/proc/uptime, sysinfo, /proc/stat
+ * btime) so a uid with a registered clock_offset presents a coherent uptime
+ * across ALL the channels the Snap member cross-reads, not just clock_gettime.
+ */
+long long susfs_get_clock_boot_off_current(void) {
+	struct st_susfs_clock_offset_hlist *entry;
+	uid_t uid;
+	long long d = 0;
+
+	if (!susfs_clock_offset_active)
+		return 0;
+	uid = current_uid().val;
+
+	spin_lock(&susfs_spin_lock);
+	hash_for_each_possible(CLOCK_OFFSET_HLIST, entry, node, uid) {
+		if (entry->target_uid == uid) {
+			d = entry->delta_boot_ns;
+			break;
+		}
+	}
+	spin_unlock(&susfs_spin_lock);
+	return d;
+}
 #endif // #ifdef CONFIG_KSU_SUSFS_CLOCK_OFFSET

diff --git a/fs/proc/uptime.c b/fs/proc/uptime.c
--- a/fs/proc/uptime.c
+++ b/fs/proc/uptime.c
@@ -20,6 +20,15 @@ static int uptime_proc_show(struct seq_file *m, void *v)
 		nsec += (__force u64) kcpustat_cpu(i).cpustat[CPUTIME_IDLE];

 	get_monotonic_boottime(&uptime);
+#ifdef CONFIG_KSU_SUSFS_CLOCK_OFFSET
+	{
+		extern long long susfs_get_clock_boot_off_current(void);
+		long long _boff = susfs_get_clock_boot_off_current();
+
+		if (_boff > 0)
+			timespec_add_ns(&uptime, (u64)_boff);
+	}
+#endif
 	idle.tv_sec = div_u64_rem(nsec, NSEC_PER_SEC, &rem);
 	idle.tv_nsec = rem;
 	seq_printf(m, "%lu.%02lu %lu.%02lu\n",

diff --git a/kernel/sys.c b/kernel/sys.c
--- a/kernel/sys.c
+++ b/kernel/sys.c
@@ -2640,6 +2640,15 @@ static int do_sysinfo(struct sysinfo *info)
 	get_monotonic_boottime(&tp);
 	info->uptime = tp.tv_sec + (tp.tv_nsec ? 1 : 0);
+#ifdef CONFIG_KSU_SUSFS_CLOCK_OFFSET
+	{
+		extern long long susfs_get_clock_boot_off_current(void);
+		long long _boff = susfs_get_clock_boot_off_current();
+
+		if (_boff > 0)
+			info->uptime += (long)(_boff / NSEC_PER_SEC);
+	}
+#endif

 	get_avenrun(info->loads, 0, SI_LOAD_SHIFT - FSHIFT);

diff --git a/fs/proc/stat.c b/fs/proc/stat.c
--- a/fs/proc/stat.c
+++ b/fs/proc/stat.c
@@ -95,6 +95,15 @@ static int show_stat(struct seq_file *p, void *v)
 	guest = guest_nice = 0;
 	getboottime64(&boottime);
+#ifdef CONFIG_KSU_SUSFS_CLOCK_OFFSET
+	{
+		extern long long susfs_get_clock_boot_off_current(void);
+		long long _boff = susfs_get_clock_boot_off_current();
+
+		if (_boff > 0)
+			boottime.tv_sec -= (time64_t)(_boff / NSEC_PER_SEC);
+	}
+#endif

 	for_each_possible_cpu(i) {
 		user += kcpustat_cpu(i).cpustat[CPUTIME_USER];
